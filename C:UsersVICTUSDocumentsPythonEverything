from nemo.collections.asr.models import ASRModel
from nemo.utils import logging, model_utils

def setup_model_for_training(config):
    cfg = model_utils.convert_model_config_to_dict_config(config)
    asr_model = ASRModel.from_pretrained(model_name=config.init_from_pretrained_model)

    decoder = asr_model.decoder.state_dict()
    joint_state = asr_model.joint.state_dict()
    prev_vocab_size = asr_model.tokenizer.vocab_size
    asr_model.change_vocabulary(new_tokenizer_dir=config.tokenizer.dir, new_tokenizer_type=config.tokenizer.type)
    if asr_model.tokenizer.vocab_size == prev_vocab_size:
        asr_model.decoder.load_state_dict(decoder)
        asr_model.joint.load_state_dict(joint_state)

    asr_model.setup_training_data(cfg.asr_model.train_ds)
    asr_model.setup_validation_data(cfg.model.validation_ds)
    asr_model.setup_optimization(cfg.model.optim)
    return asr_model

