import torch
from lightning.pytorch import Trainer
from nemo.utils.exp_manager import exp_manager

from fongbe.build import fine_tune_fongbe
from fongbe.model import setup_model_for_training
from fongbe import callbacks as f_call


from torch.distributed.algorithms._checkpoint.checkpoint_wrapper import CheckpointImpl, checkpoint_wrapper

def get_device():
    if torch.cuda.is_available():
        accelerator = 'gpu'
    else:
        accelerator = 'gpu'
    return accelerator

def enable_gradient_checkpointing(asr_model):
    for i, layer in enumerate(asr_model.encoder.layers):
        asr_model.encoder.layers[i] = checkpoint_wrapper(
            layer,
            checkpoint_impl=CheckpointImpl.NO_REENTRANT
    )

def train_fongbe(model_name, exp_dir, repo_id):
    config = fine_tune_fongbe.load_fongbe_cfg(model_name, exp_dir)
    asr_model = setup_model_for_training(config)
    callbacks = [
        f_call.HFStreamCheckpointCallback(),
        f_call.HFHubUploadCallback(repo_id=repo_id, exp_dir=exp_dir)
    ]

    trainer = Trainer(**config.trainer, callbacks=callbacks)
    exp_manager(trainer, config.exp_manager)
    return trainer


